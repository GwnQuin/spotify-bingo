generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  accounts      Account[]
  sessions      Session[]
  themes        Theme[]
  gameSessions  GameSession[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Theme {
  id                   String         @id @default(cuid())
  userId               String
  naam                 String
  beschrijving         String?
  standaardStartSeconden Int          @default(0)
  standaardOnthulSeconden Int         @default(20)
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
  user                 User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  tracks               ThemeTrack[]
  gameSessions         GameSession[]
}

model ThemeTrack {
  id               String   @id @default(cuid())
  themeId          String
  spotifyTrackId   String
  titel            String
  artiest          String
  albumNaam        String?
  albumAfbeelding  String?
  previewUrl       String?
  startSeconden    Int?
  onthulSeconden   Int?
  isJoker          Boolean  @default(false)
  volgorde         Int      @default(0)
  theme            Theme    @relation(fields: [themeId], references: [id], onDelete: Cascade)

  @@index([themeId, volgorde])
}

model GameSession {
  id                         String    @id @default(cuid())
  userId                     String
  themeId                    String
  naam                       String
  speelmodus                 String    @default("EXTERN")
  blindekaartmodus           Boolean   @default(false)
  toonArtiestVoorOnthulling  Boolean   @default(false)
  actievePatronenJson        String
  willekeurigeVolgorde       Boolean   @default(false)
  huidigeTrackIndex          Int       @default(0)
  isPauze                    Boolean   @default(false)
  createdAt                  DateTime  @default(now())
  updatedAt                  DateTime  @updatedAt
  user                       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  theme                      Theme     @relation(fields: [themeId], references: [id], onDelete: Cascade)
}
